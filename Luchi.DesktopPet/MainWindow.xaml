<Window x:Class="Luchi.DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luchi Desktop Pet"
        Height="380"
        Width="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <Border x:Name="SpeechBubble"
                Grid.Row="0"
                Margin="10,4,10,8"
                Padding="12,8"
                Background="#FFFDF8"
                BorderBrush="#D5BF9B"
                BorderThickness="1"
                CornerRadius="14"
                VerticalAlignment="Bottom"
                Visibility="Hidden"
                IsHitTestVisible="False">

            <TextBlock x:Name="BubbleText"
                       FontSize="16"
                       Foreground="#524B5A"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <Image x:Name="PetImage"
               Grid.Row="1"
               ImageFailed="PetImage_ImageFailed"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
               LostMouseCapture="PetImage_LostMouseCapture"
               Source="/Assets/luchi-happy.png"
               Width="280"
               Height="280"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Cursor="Hand">

            <Image.RenderTransform>
                <ScaleTransform x:Name="PetScale"
                                ScaleX="1"
                                ScaleY="1"
                                CenterX="140"
                                CenterY="270" />
            </Image.RenderTransform>

            <Image.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="隱藏露希"
                            Click="HideMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="離開"
                            Click="ExitMenuItem_Click" />
                </ContextMenu>
            </Image.ContextMenu>

        </Image>

        <Canvas x:Name="CalibrationGuide"
                Grid.Row="1"
                Width="280"
                Height="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False">

            <Line X1="10"
                Y1="20"
                X2="270"
                Y2="20"
                Stroke="#808080"
                StrokeThickness="1"
                StrokeDashArray="4,4" />

            <Line X1="10"
                Y1="270"
                X2="270"
                Y2="270"
                Stroke="#E08835"
                StrokeThickness="1" />

            <Line X1="140"
                Y1="260"
                X2="140"
                Y2="279"
                Stroke="#E08835"
                StrokeThickness="1" />
        </Canvas>
    </Grid>
</Window>